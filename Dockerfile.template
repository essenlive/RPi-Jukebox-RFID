# Balena Dockerfile for Phoniebox (RPi-Jukebox-RFID)
# Using latest safe Debian Bookworm base image
FROM balenalib/%%BALENA_MACHINE_NAME%%-debian:bookworm

# Enable systemd init system
ENV INITSYSTEM on

# Install runtime dependencies
RUN install_packages \
    samba \
    samba-common-bin \
    gcc \
    lighttpd \
    php-common \
    php-cgi \
    php \
    at \
    mpd \
    mpc \
    mpg123 \
    git \
    ffmpeg \
    resolvconf \
    spi-tools \
    netcat-traditional \
    alsa-utils \
    lsof \
    procps \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    python3-mutagen \
    python3-spidev \
    swig \
    tar \
    unzip \
    wget \
    systemd \
    dbus \
    udev \
    bluetooth \
    bluez \
    bluez-tools \
    libasound2-plugins \
    pulseaudio \
    pulseaudio-module-bluetooth

# Set working directory
WORKDIR /home/phoniebox/RPi-Jukebox-RFID

# Copy application files
COPY . .

# Install Python dependencies
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Create necessary directories
RUN mkdir -p /home/phoniebox/RPi-Jukebox-RFID/shared/audiofolders \
    /home/phoniebox/RPi-Jukebox-RFID/shared/playlists \
    /home/phoniebox/RPi-Jukebox-RFID/logs \
    /var/www/html

# Configure lighttpd
RUN mkdir -p /var/log/lighttpd && \
    chown www-data:www-data /var/log/lighttpd && \
    rm -rf /var/www/html/* && \
    ln -sf /home/phoniebox/RPi-Jukebox-RFID/htdocs /var/www/html/phoniebox

# Configure MPD
RUN mkdir -p /var/lib/mpd/music /var/lib/mpd/playlists && \
    ln -sf /home/phoniebox/RPi-Jukebox-RFID/shared/audiofolders /var/lib/mpd/music/audiofolders && \
    chown -R mpd:audio /var/lib/mpd

# Configure Bluetooth
RUN usermod -G bluetooth -a www-data && \
    usermod -G bluetooth -a mpd && \
    mkdir -p /var/run/dbus

# Copy startup script
COPY balena-start.sh /usr/local/bin/balena-start.sh
RUN chmod +x /usr/local/bin/balena-start.sh

# Expose web interface port
EXPOSE 80

# Set environment variables for Phoniebox
ENV JUKEBOX_HOME_DIR=/home/phoniebox/RPi-Jukebox-RFID
ENV PULSE_SERVER=tcp:audio:4317

# Start services
CMD ["/usr/local/bin/balena-start.sh"]
